# ManageEngine ServiceDesk Plus API v3 connection settings.
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored.

# Base URL of the on-premise SDP server (no trailing slash), e.g. https://sdp.internal.local
SDP_BASE_URL=

# Technician API key. Sent in the `authtoken` request header.
SDP_AUTHTOKEN=

# Verify TLS certificate. Set to false for on-premise self-signed certs.
SDP_VERIFY_SSL=false

# Page size for list endpoints (server max is 100).
SDP_ROW_COUNT=100

# Seconds to sleep between requests to stay under rate limits.
SDP_RATE_LIMIT_SLEEP=0.2

# HTTP request timeout in seconds.
SDP_TIMEOUT=60

# Number of retries for transient errors (429 / 5xx).
SDP_MAX_RETRIES=4
